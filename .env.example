# --- core ---
DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.eu-central-1.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="<openssl rand -base64 32>"
APP_URL="https://your-domain.example"

# --- e-mail for password reset (optional; without it Neon sends its own e-mails) ---
RESEND_API_KEY=""
EMAIL_FROM="StudyApp <study@your-domain.example>"

# --- screen time ---
SCREEN_ADMIN_KEY="<openssl rand -hex 24>"   # header x-admin-key for /api/screen/admin
PARENT_EMAILS="parent@example.com"          # these accounts see /admin
PARENT_PIN="1234"                           # code that opens parent settings inside the phone app

# --- push to the phone (optional; without it the phone picks changes up on open / background refresh) ---
APNS_TEAM_ID=""
APNS_KEY_ID=""
APNS_KEY_P8=""                              # base64 of the .p8 file
APNS_BUNDLE_ID="com.example.studyapp"
APNS_ENV="sandbox"

# --- Telegram: "ask for more time" requests to the parent (optional) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_PARENT_CHAT_ID=""
TELEGRAM_WEBHOOK_SECRET="<openssl rand -hex 16>"
